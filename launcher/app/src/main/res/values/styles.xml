<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- A frosted pill (background and colours set in code from the region's pair). 28dp = 56px tall. -->
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Launcher dialogs: dark translucent card, rows like the inputs menu (solid light row + #111 text on focus). -->
    <style name="MenuDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_bg</item>
        <item name="android:textColorPrimary">#FFEEEEEE</item>
        <item name="android:textColorAlertDialogListItem">@color/menu_row_text</item>
        <item name="android:colorAccent">#FF8A8A8A</item>
        <item name="android:colorControlNormal">#FF8A8A8A</item>
        <item name="android:colorControlActivated">#FF8A8A8A</item>
        <item name="android:listSelector">@drawable/menu_row_bg</item>
    </style>
    <style name="MenuDialog.Night">
        <item name="android:textColorPrimary">#FFFFE2B8</item>
        <item name="android:textColorAlertDialogListItem">@color/menu_row_text_night</item>
    </style>
</resources>
