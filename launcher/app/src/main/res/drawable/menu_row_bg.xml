<?xml version="1.0" encoding="utf-8"?>
<!-- Menu row: solid near-white when focused/selected, clear otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#FFF2F2F2" /><corners android:radius="10dp" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#FFF2F2F2" /><corners android:radius="10dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#FFDDDDDD" /><corners android:radius="10dp" /></shape></item>
    <item><color android:color="#00000000" /></item>
</selector>
