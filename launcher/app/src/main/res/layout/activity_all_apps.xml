<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- v38: the home screen's photo, heavy blur under Looks.ALL_APPS_SCRIM behind the grid. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="60dp"
            android:paddingTop="28dp"
            android:paddingBottom="14dp"
            android:text="@string/all_apps"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:shadowColor="#80000000"
            android:shadowRadius="6"
            android:fontFamily="sans-serif-light" />

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="6"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="12dp"
            android:stretchMode="columnWidth"
            android:listSelector="@android:color/transparent"
            android:drawSelectorOnTop="false"
            android:clipToPadding="false"
            android:paddingStart="52dp"
            android:paddingEnd="52dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants" />
    </LinearLayout>

    <!-- v42: orders column on the right; hidden (grid full width) when there are no orders. -->
    <LinearLayout
        android:id="@+id/orders_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/orders_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/orders_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="false" />

            <ImageView
                android:id="@+id/orders_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/orders_refresh"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/orders_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fadingEdge="vertical"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="40dp"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants">

            <LinearLayout
                android:id="@+id/orders_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
